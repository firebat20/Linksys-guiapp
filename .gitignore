yarn-error.log*
pnpm-debug.log*

# Environment and local secret overrides
.env
.env.local
.env.*.local

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
